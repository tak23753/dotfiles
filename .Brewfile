cask_args appdir: "/Applications"

tap "homebrew/bundle"
tap "homebrew/cask-versions"
tap "shivammathur/php"

brew "curl"
brew "git"
brew "shellcheck"
brew "tree"
brew "watch"
brew "wget"
brew "colordiff"
brew "awscli"
brew "mkcert"
brew "libpq"
brew "hadolint"
brew "goodwithtech/r/dockle"
brew "aquasecurity/trivy/trivy"
brew "peco"
brew "mas"
brew "graphviz"
brew "fujiwara/tap/tracer"
brew "jq"
brew "pre-commit"
brew "aquaproj/aqua/aqua"
brew "shivammathur/php/php@7.4", link: true
brew "kind"
brew "kubectl"
brew "kubectx"
brew "stern"
brew "coreutils"
brew "asdf"

cask "alfred"
cask "docker"
cask "iterm2"
cask "visual-studio-code"
cask "postman"
cask "karabiner-elements"
cask "1password"
cask "tableplus"
cask "adoptopenjdk"
cask "raindropio"
cask "dropbox"
cask "session-manager-plugin"
cask "ticktick"
cask "bettertouchtool"
cask "obsidian"
cask "cyberduck"
cask "alt-tab"
cask "google-cloud-sdk"
