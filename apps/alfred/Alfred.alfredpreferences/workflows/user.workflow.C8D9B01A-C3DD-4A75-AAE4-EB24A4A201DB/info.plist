import json
import glob
import os

query = sys.argv[1] if len(sys.argv) &gt; 1 else ""

results = []
for name in glob.glob(
    os.path.join(os.path.expanduser("~"), f"Documents/forcas/*{query}*")
):
    dir_name = os.path.basename(name)
    results.append(
        {
            "uid": dir_name,
            "type": "file",
            "title": dir_name,
            "subtitle": name,
            "arg": name,
            "autocomplete": dir_name,
            "icon": {"type": "fileicon", "path": name},
        }
    )

sys.stdout.write(json.dumps({"items": results}, ensure_ascii=False))
